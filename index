        '<img class="thumb-illus drive-thumb" style="width:100%;height:100%;object-fit:cover;" src="https://drive.google.com/thumbnail?id=' + video.id + '&sz=w640" alt="" loading="lazy">' +
        '<button class="play-btn" type="button" aria-label="تشغيل الفيديو"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg></button>' +
