#simApp *{box-sizing:border-box}
#simApp .i{width:1em;height:1em;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;flex:none}
#simApp .sim-hero{position:relative;overflow:hidden;color:#fff;border-radius:28px;padding:22px 32px 30px;background:radial-gradient(520px 320px at 88% -12%,rgba(139,108,255,.5),transparent),radial-gradient(420px 420px at 0% 110%,rgba(91,61,245,.45),transparent),linear-gradient(120deg,#140a50,#3a20c8 62%,#5b3df5)}
