#simApp .expMenu{display:none;position:absolute;top:calc(100% + 8px);right:0;background:var(--cd);border:1px solid var(--bd);border-radius:12px;box-shadow:var(--sh);overflow:hidden;min-width:172px;z-index:30}
#simApp .expItem{display:block;width:100%;text-align:left;padding:11px 15px;background:transparent;border:0;color:var(--tx);font:600 12px Inter,sans-serif;cursor:pointer}
#simApp .expItem+.expItem{border-top:1px solid var(--bd)}
#simApp .expItem:hover{background:var(--hp)}
#simApp .pill{font-weight:600;border-radius:22px;padding:8px 18px;background:rgba(251,191,36,.18);color:#fde68a;display:flex;align-items:center;border:1px solid rgba(255,255,255,.15)}
