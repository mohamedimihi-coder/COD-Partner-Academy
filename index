<script>

(function(){
  var SITE_PASSWORD = 'Sellerpro';

  /* Normalise what the seller typed before comparing. The old check was an exact
     match, so any tiny difference locked people out: first letter in lower case
     (phone keyboards), a space added by autocorrect, an invisible RTL mark that
     comes along when the password is copied from WhatsApp / an Arabic chat, or
     full-width letters. We now ignore case, spaces and invisible characters. */
  function normalizePwd(v){
    return String(v == null ? '' : v)
      .normalize('NFKC')
      .replace(/[\u00AD\u200B-\u200F\u202A-\u202E\u2060-\u2064\uFEFF]/g, '')
      .replace(/\s+/g, '')
      .replace(/["'`\u00B4\u2018\u2019\u201C\u201D\u00AB\u00BB]/g, '')
      .replace(/^[.,;:!?\u060C\u061B\u061F]+|[.,;:!?\u060C\u061B\u061F]+$/g, '')
      .toLowerCase();
  }
  var SITE_PASSWORD_NORM = normalizePwd(SITE_PASSWORD);
  var MSG_WRONG   = 'كلمة المرور غير صحيحة، حاول مرة أخرى.';
  var MSG_EMPTY   = 'فضلاً أدخل كلمة المرور.';
  var MSG_ARABIC  = 'يبدو أن لوحة المفاتيح بالعربية. بدّلها إلى الإنجليزية (English) ثم حاول مجدداً.';

  var pwd = document.getElementById('password');
  var toggle = document.getElementById('toggleEye');
  var eyeIcon = document.getElementById('eyeIcon');
  var EYE_OPEN = '<path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7z"/><circle cx="12" cy="12" r="3"/>';
  var EYE_OFF  = '<path d="M17.9 17.9A10.4 10.4 0 0 1 12 20c-7 0-11-8-11-8a18.7 18.7 0 0 1 5-5.9"/><path d="M9.9 5.2A9.6 9.6 0 0 1 12 5c7 0 11 8 11 8a18.7 18.7 0 0 1-2.5 3.6"/><path d="M14.1 14.1a3 3 0 1 1-4.2-4.2"/><path d="M2 2l20 20"/>';

  toggle.addEventListener('click', function(){
    var showing = pwd.type === 'text';
    pwd.type = showing ? 'password' : 'text';
    eyeIcon.innerHTML = showing ? EYE_OPEN : EYE_OFF;
    toggle.setAttribute('aria-pressed', String(!showing));
    toggle.setAttribute('aria-label', showing ? 'إظهار كلمة المرور' : 'إخفاء كلمة المرور');
  });

  var form = document.getElementById('loginForm');
  var emailField = document.getElementById('emailField');
  var passwordField = document.getElementById('passwordField');
  var emailInput = document.getElementById('email');
  var submitBtn = document.getElementById('submitBtn');
  var btnLabel = submitBtn.querySelector('.btn-label');
  var toast = document.getElementById('successToast');
  var submitting = false;   // blocks double clicks / double Enter while the login is in progress

  /* Typed the right password with the ARABIC keyboard still on? Same physical keys, so we translate the
     Arabic letters back to the English key they sit on (PC / Mac / Android / iPhone Arabic layouts all
     share this arrangement) and accept it instead of showing "wrong password". */
  var AR_KEYS = {
    'ض':'q','ص':'w','ث':'e','ق':'r','ف':'t','غ':'y','ع':'u','ه':'i','خ':'o','ح':'p','ج':'[','د':']',
    'ش':'a','س':'s','ي':'d','ب':'f','ل':'g','ا':'h','ت':'j','ن':'k','م':'l','ك':';','ط':"'",
    'ئ':'z','ء':'x','ؤ':'c','ر':'v','ى':'n','ة':'m','و':',','ز':'.','ظ':'/',
    'إ':'y','أ':'h','آ':'n',
    '\u064E':'q','\u064B':'w','\u064F':'e','\u064C':'r','\u0650':'a','\u064D':'s','\u0652':'x'   /* harakat = Shift + key */
  };
  function arabicKeysToLatin(v){
    var t = String(v).replace(/\u0644\u0627/g,'b').replace(/\u0644\u0623/g,'g').replace(/\u0644\u0625/g,'t').replace(/\u0644\u0622/g,'b');
    var out = '';
    for (var i = 0; i < t.length; i++){
      var c = t.charAt(i), code = t.charCodeAt(i);
      if (AR_KEYS.hasOwnProperty(c)) out += AR_KEYS[c];
      else if (code >= 0x0660 && code <= 0x0669) out += String(code - 0x0660);   /* ٠-٩ */
      else if (code >= 0x06F0 && code <= 0x06F9) out += String(code - 0x06F0);   /* ۰-۹ */
      else out += c;
    }
    return out;
  }
  function passwordMatches(v){
    if (normalizePwd(v) === SITE_PASSWORD_NORM) return true;
    if (/[\u0600-\u06FF]/.test(String(v))) return normalizePwd(arabicKeysToLatin(v)) === SITE_PASSWORD_NORM;
    return false;
  }

  function resetButton(){
    submitting = false;
    submitBtn.classList.remove('loading');
    submitBtn.disabled = false;
    btnLabel.textContent = 'تسجيل الدخول';
  }
  function showDashboard(){
    if (typeof window.goToDashboard === 'function') {
      window.goToDashboard();
    } else {   /* safety net: never leave the seller stuck on the login screen */
      var ls = document.getElementById('loginScreen'), ds = document.getElementById('dashboardScreen');
      if (ls) ls.style.display = 'none';
      if (ds) ds.style.display = '';
      window.scrollTo(0, 0);
    }
    resetButton();
  }

  /* the red error goes away as soon as the seller starts typing again */
  pwd.addEventListener('input', function(){ passwordField.classList.remove('invalid'); });

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (submitting) return;
    toast.classList.remove('show');

    /* The e-mail is not checked against anything (there is no server), so it must never keep out a seller
       who typed the right password. We only clear any old error state here. */
    emailField.classList.remove('invalid');
    if (!passwordMatches(pwd.value)) {
      var typed = pwd.value;
      var msgEl = passwordField.querySelector('.field-error');
      if (msgEl) {
        msgEl.textContent = !typed.trim() ? MSG_EMPTY
                          : /[\u0600-\u06FF]/.test(typed) ? MSG_ARABIC
                          : MSG_WRONG;
      }
      passwordField.classList.add('invalid');
      try { pwd.focus(); } catch (err) {}
      return;
    }
    passwordField.classList.remove('invalid');

    submitting = true;
    submitBtn.classList.add('loading');
    submitBtn.disabled = true;
    btnLabel.textContent = 'جارٍ تسجيل الدخول...';

    setTimeout(function(){
      toast.classList.add('show');
      setTimeout(showDashboard, 500);   /* password correct -> reveal the dashboard */
    }, 900);
  });

  // called by the dashboard's logout buttons to come back here
  window.goToLogin = function(){
    var loginScreen = document.getElementById('loginScreen');
    var dashboardScreen = document.getElementById('dashboardScreen');
    if (dashboardScreen) dashboardScreen.style.display = 'none';
    if (loginScreen) loginScreen.style.display = '';
    toast.classList.remove('show');
    resetButton();
    pwd.value = '';
    pwd.type = 'password';                    /* never leave the password visible for the next person */
    eyeIcon.innerHTML = EYE_OPEN;
    toggle.setAttribute('aria-pressed', 'false');
    toggle.setAttribute('aria-label', 'إظهار كلمة المرور');
    passwordField.classList.remove('invalid');
    window.scrollTo(0, 0);
  };
})();

</script>

