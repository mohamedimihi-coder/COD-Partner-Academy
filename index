<script>
/* ===== THEME (light / dark) =====
   - the choice is saved in this browser (localStorage "cwi-theme"); first visit = light
   - to follow the phone/computer setting on the first visit instead, change the fallback in the head script */
(function(){
  var KEY = 'cwi-theme', root = document.documentElement;
  var MOON = '<path d="M20.5 14.5A8.5 8.5 0 1 1 9.5 3.5a7 7 0 0 0 11 11z"/>';
  var SUN  = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>';
  function current(){ return root.getAttribute('data-theme') === 'dark' ? 'dark' : 'light'; }
  function paint(){
    var dark = current() === 'dark';
    var btns = document.querySelectorAll('.theme-toggle');
    for (var i = 0; i < btns.length; i++){
      var b = btns[i], svg = b.querySelector('svg');
      if (svg) svg.innerHTML = dark ? SUN : MOON;
      b.setAttribute('aria-pressed', String(dark));
      var label = dark ? 'تفعيل الوضع الفاتح' : 'تفعيل الوضع الداكن';
      b.setAttribute('aria-label', label); b.title = label;
    }
  }
  window.setSiteTheme = function(t){
    t = (t === 'dark') ? 'dark' : 'light';
    root.classList.add('theme-anim');
    if (t === 'dark') root.setAttribute('data-theme', 'dark'); else root.removeAttribute('data-theme');
    try { localStorage.setItem(KEY, t); } catch(e) {}
    paint();
    document.dispatchEvent(new CustomEvent('sitethemechange', { detail: t }));
    setTimeout(function(){ root.classList.remove('theme-anim'); }, 350);
  };
  document.addEventListener('click', function(e){
    var b = e.target.closest && e.target.closest('.theme-toggle');
    if (!b) return;
    e.preventDefault();
    window.setSiteTheme(current() === 'dark' ? 'light' : 'dark');
  });
  paint();
})();
</script>
<script id="cod-flags">
(function(){
  var FLAGS = {"AE": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#fff\"/><rect width=\"60\" height=\"13.34\" fill=\"#00732f\"/><rect y=\"26.67\" width=\"60\" height=\"13.33\" fill=\"#111\"/><rect width=\"15\" height=\"40\" fill=\"#e8112d\"/></svg>", "SA": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#006c35\"/><path d=\"M13 14.5c2-3.4 4-3.4 5 0s3 3.4 5 0 3-3.4 5 0 3 3.4 5 0 3-3.4 5 0 3 3.4 4 1\" fill=\"none\" stroke=\"#fff\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M19 21h22\" stroke=\"#fff\" stroke-width=\"1.6\" stroke-linecap=\"round\"/><path d=\"M12 29l4.5-1.3H44v2.6H16.5z\" fill=\"#fff\"/><rect x=\"43\" y=\"25.8\" width=\"2.2\" height=\"6.4\" rx=\"1\" fill=\"#fff\"/><rect x=\"45\" y=\"27.9\" width=\"5\" height=\"2.2\" rx=\"1\" fill=\"#fff\"/></svg>", "KW": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#fff\"/><rect width=\"60\" height=\"13.34\" fill=\"#007a3d\"/><rect y=\"26.67\" width=\"60\" height=\"13.33\" fill=\"#ce1126\"/><path d=\"M0 0L15 13.34V26.67L0 40z\" fill=\"#111\"/></svg>", "QA": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#8a1538\"/><path d=\"M0 0H16L24 2.22L16 4.44L24 6.67L16 8.89L24 11.11L16 13.33L24 15.56L16 17.78L24 20.0L16 22.22L24 24.44L16 26.67L24 28.89L16 31.11L24 33.33L16 35.56L24 37.78L16 40.0H0z\" fill=\"#fff\"/></svg>", "OM": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#fff\"/><rect y=\"13.34\" width=\"60\" height=\"13.33\" fill=\"#db161b\"/><rect y=\"26.67\" width=\"60\" height=\"13.33\" fill=\"#008000\"/><rect width=\"20\" height=\"40\" fill=\"#db161b\"/><g fill=\"none\" stroke=\"#fff\" stroke-width=\"1.2\"><circle cx=\"10\" cy=\"8\" r=\"3.6\"/><path d=\"M6.4 11.6l7.2-7.2M13.6 11.6L6.4 4.4\"/></g></svg>", "BH": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#ce1126\"/><path d=\"M0 0H16L24 4.0L16 8.0L24 12.0L16 16.0L24 20.0L16 24.0L24 28.0L16 32.0L24 36.0L16 40.0H0z\" fill=\"#fff\"/></svg>", "IQ": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 60 40\"><rect width=\"60\" height=\"40\" fill=\"#fff\"/><rect width=\"60\" height=\"13.34\" fill=\"#ce1126\"/><rect y=\"26.67\" width=\"60\" height=\"13.33\" fill=\"#111\"/><path d=\"M16 21c1.6-3.6 3.2-3.6 4.8 0s3.2 3.6 4.8 0 3.2-3.6 4.8 0 3.2 3.6 4.8 0 3.2-3.6 4.8 0 3.2 3.6 3.8 1\" fill=\"none\" stroke=\"#007a3d\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>"};
  var NAMES = {'saudi arabia':'SA','ksa':'SA','saudi':'SA','uae':'AE','united arab emirates':'AE','kuwait':'KW','qatar':'QA','oman':'OM','bahrain':'BH','iraq':'IQ'};
  function src(code){ return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(FLAGS[code]); }
  function flagImg(code){ var i = document.createElement('img'); i.className = 'cf-flag'; i.alt = ''; i.src = src(code); i.setAttribute('draggable','false'); return i; }
  function clean(t){ return String(t).replace(/[\uD83C][\uDDE6-\uDDFF]/g,'').replace(/\s+/g,' ').trim(); }
  function codeOf(t){ return NAMES[clean(t).toLowerCase()] || ''; }

  /* static flags (login preview) */
  [].forEach.call(document.querySelectorAll('[data-flag]'), function(el){
    var c = el.getAttribute('data-flag'); if(FLAGS[c]){ el.textContent = ''; el.appendChild(flagImg(c)); }
  });

  var openPop = null;
  function isDark(btn){
    var h = document.documentElement.getAttribute('data-theme') === 'dark';
    var a = btn.closest('#simApp'); var b = btn.closest('#kpiApp');
    return h || (a && a.getAttribute('data-theme') === 'dark') || (b && b.getAttribute('data-theme') === 'dark');
  }
  function closeAny(){ if(openPop){ openPop(); } }

  function enhance(sel){
    if(!sel || sel.getAttribute('data-cf')) return;
    sel.setAttribute('data-cf','1');
    var host = document.createElement('span'); host.className = 'cf-host'; host.style.cssText = 'display:block;width:100%';
    var btn = document.createElement('button'); btn.type = 'button'; btn.className = 'cf-btn';
    btn.setAttribute('aria-haspopup','listbox'); btn.setAttribute('aria-expanded','false'); btn.setAttribute('aria-label','Country');
    host.appendChild(btn);
    sel.parentNode.insertBefore(host, sel.nextSibling);
    sel.style.display = 'none'; sel.setAttribute('aria-hidden','true'); sel.tabIndex = -1;

    function chevron(){
      var ns='http://www.w3.org/2000/svg', v=document.createElementNS(ns,'svg'); v.setAttribute('viewBox','0 0 12 12'); v.setAttribute('class','cf-chev'); v.setAttribute('aria-hidden','true');
      var p=document.createElementNS(ns,'path'); p.setAttribute('d','M2 4.2l4 4 4-4'); v.appendChild(p); return v;
    }
    function sync(){
      var o = sel.options[sel.selectedIndex]; var txt = o ? o.text : ''; var code = codeOf(txt);
      btn.textContent = '';
      btn.classList.toggle('cf-ph', !code);
      if(code && btn.closest('#kpiApp')){ btn.appendChild(flagImg(code)); }
      var t = document.createElement('span'); t.className = 'cf-txt'; t.textContent = clean(txt); btn.appendChild(t);
      if(code && !btn.closest('#kpiApp')){ btn.appendChild(flagImg(code)); }
      btn.appendChild(chevron());
    }
    /* keep the button in sync when the page's own code sets the value (reset buttons etc.) */
    ['value','selectedIndex'].forEach(function(prop){
      var d = Object.getOwnPropertyDescriptor(HTMLSelectElement.prototype, prop);
      Object.defineProperty(sel, prop, {configurable:true, get:function(){ return d.get.call(this); }, set:function(v){ d.set.call(this, v); sync(); }});
    });
    sync();

    var pop = null, act = -1;
    function items(){ return pop ? pop.querySelectorAll('.cf-opt') : []; }
    function setAct(i){
      var it = items(); if(!it.length) return;
      act = (i + it.length) % it.length;
      [].forEach.call(it, function(el, k){ el.classList.toggle('cf-act', k === act); });
      it[act].scrollIntoView({block:'nearest'});
    }
    function place(){
      if(!pop) return;
      var r = btn.getBoundingClientRect();
      var w = Math.max(r.width, 210); pop.style.width = w + 'px';
      var left = btn.closest('#simApp') ? r.right - w : r.left;
      left = Math.max(8, Math.min(left, window.innerWidth - w - 8));
      var h = pop.offsetHeight, top = r.bottom + 6;
      if(top + h > window.innerHeight - 8 && r.top > h + 14) top = r.top - h - 6;
      pop.style.left = left + 'px'; pop.style.top = top + 'px';
    }
    function close(focus){
      if(!pop) return;
      document.removeEventListener('pointerdown', onOut, true);
      window.removeEventListener('resize', onWin); window.removeEventListener('scroll', onWin, true);
      pop.remove(); pop = null; act = -1; openPop = null; btn.setAttribute('aria-expanded','false');
      if(focus) btn.focus();
    }
    function onOut(e){ if(pop && !pop.contains(e.target) && !btn.contains(e.target)) close(false); }
    function onWin(e){ if(pop && e && e.target && pop.contains(e.target)) return; close(false); }
    function choose(i){
      sel.selectedIndex = i;
      sel.dispatchEvent(new Event('input', {bubbles:true}));
      sel.dispatchEvent(new Event('change', {bubbles:true}));
      close(true);
    }
    function open(){
      closeAny();
      pop = document.createElement('div'); pop.className = 'cf-pop' + (isDark(btn) ? ' cf-dark' : ''); pop.setAttribute('role','listbox');
      [].forEach.call(sel.options, function(o, i){
        var code = codeOf(o.text);
        var li = document.createElement('div'); li.className = 'cf-opt' + (code ? '' : ' cf-none'); li.setAttribute('role','option');
        li.setAttribute('aria-selected', i === sel.selectedIndex ? 'true' : 'false');
        if(code) li.appendChild(flagImg(code));
        var t = document.createElement('span'); t.textContent = clean(o.text); li.appendChild(t);
        if(i === sel.selectedIndex){
          var ns='http://www.w3.org/2000/svg', v=document.createElementNS(ns,'svg'); v.setAttribute('viewBox','0 0 16 16'); v.setAttribute('class','cf-ok');
          var p=document.createElementNS(ns,'path'); p.setAttribute('d','M3.5 8.5l3 3 6-7'); v.appendChild(p); li.appendChild(v);
        }
        li.addEventListener('click', function(){ choose(i); });
        li.addEventListener('mousemove', function(){ setAct(i); });
        pop.appendChild(li);
      });
      document.body.appendChild(pop);
      btn.setAttribute('aria-expanded','true');
      place(); setAct(sel.selectedIndex < 0 ? 0 : sel.selectedIndex);
      document.addEventListener('pointerdown', onOut, true);
      window.addEventListener('resize', onWin); window.addEventListener('scroll', onWin, true);
      openPop = function(){ close(false); };
    }
    btn.addEventListener('click', function(){ pop ? close(false) : open(); });
    btn.addEventListener('keydown', function(e){
      var k = e.key;
      if(!pop){
        if(k === 'ArrowDown' || k === 'ArrowUp'){ e.preventDefault(); open(); }
        return;
      }
      if(k === 'Escape'){ e.preventDefault(); close(true); }
      else if(k === 'ArrowDown'){ e.preventDefault(); setAct(act + 1); }
      else if(k === 'ArrowUp'){ e.preventDefault(); setAct(act - 1); }
      else if(k === 'Home'){ e.preventDefault(); setAct(0); }
      else if(k === 'End'){ e.preventDefault(); setAct(items().length - 1); }
      else if(k === 'Enter' || k === ' '){ e.preventDefault(); if(act >= 0) choose(act); }
      else if(k === 'Tab'){ close(false); }
    });
  }
  enhance(document.getElementById('country'));
  enhance(document.getElementById('sim-country'));
})();
</script>
</body>
</html>
