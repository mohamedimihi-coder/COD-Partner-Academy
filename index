  if(I.bud)p(`💰 Budget: $${I.bud}${x('/day per Ad Set','/jour par Ad Set')} ($${+(parseFloat(I.bud)*A.act.length).toFixed(2)}${x('/day total','/jour au total')})`);
  p(`🎬 ${x(`Number of ad sets (1 video each)`,`Nombre d'ad sets (1 vidéo chacun)`)}: ${A.act.length}`);
  p('');p(`*1. ${x('GLOBAL RESULTS','RÉSULTATS GLOBAUX')}*`);
  p(`${x('Total spend','Dépenses totales')}: ${fm(G.s)}`);if(G.r>0)p(`Reach: ${fi(G.r)}`);p(`Impressions: ${fi(G.i)}`);
  p(`${x('Link clicks','Clics sur le lien')}: ${fi(G.k)}`);p(`${x('Landing Page visits','Visites Landing Page')}: ${fi(G.l)}`);
  p(`${x('Purchases','Achats')}: ${fi(G.p)}`);p(`${x('Average CPA','CPA moyen')}: ${fm(G.cpa)}`);
  p(`${x('Weighted average CTR','CTR moyen pondéré')}: ${fp(G.ctr)}`);p(`${x('Average CPC','CPC moyen')}: ${fm(G.cpc)}`);
  p(`${x('LPV → Purchase conversion','Taux de conversion LPV → Achat')}: ${fp(G.cvr)}`);
  p('');p(`*2. ${x('PERFORMANCE BY VIDEO','PERFORMANCE PAR VIDÉO')}*`);
  A.act.forEach(a=>{const v=V[a.v],k=a.k;p('');
    p(`${v.e} *${nm(a).toUpperCase()}* – ${vl(v)}`);
    if(a.c.adset.trim())p(`🎯 Ad Set: ${a.c.adset.trim()}`);
    p(`${x('Spend','Dépenses')}: ${fm(k.s)} | Impressions: ${fi(k.i)}${k.r>0?` | Reach: ${fi(k.r)}`:''}`);
    p(`${x('Clicks','Clics')}: ${fi(k.k)} | CTR: ${fp(k.ctr)} | CPC: ${fm(k.cpc)}`);
    p(`Hook Rate: ${fp(k.hook)}${num(a.c.hold)!=null?` | Hold Rate: ${num(a.c.hold).toFixed(2)}%`:''}`);
    p(`Landing Page Views: ${fi(k.l)} | LPV → ${x('Purchase','Achat')}: ${fp(k.cvr)}`);
    p(`${x('Purchases','Achats')}: ${fi(k.p)} | CPA: ${fm(k.cpa)}`);
    p(`${x('Analysis','Analyse')}: ${vt(v)}`);});
  p('');p(`*3. ${x('BEST & WEAKEST','MEILLEUR & PLUS FAIBLE')}*`);
  p(`🏆 ${x('Best creative','Meilleur créatif')}: ${A.best?nm(A.best):'N/A'}`);
  if(A.watch)p(`⚠️ ${x('Creative to watch','Créatif à surveiller')}: ${nm(A.watch)}`);
  p(`🔴 ${x('Weakest creative','Créatif le plus faible')}: ${A.weak?nm(A.weak):'N/A'}`);
  const R=REC[A.rec];p('');p(`*4. ${x('COACH RECOMMENDATION','RECOMMANDATION COACH')}*`);
  p(`${R.e} *${vl(R)}*`);p(vt(R));
  p('');p(`*5. ${x('KEY INSIGHTS','INSIGHTS CLÉS')}*`);insights(A).forEach(s=>p(`• ${s}`));
  return o.join('\n');
})}

/* ===== Rendering ===== */
function newC(v){return{id:++uid,name:'',adset:'',kctr:'',kcpc:'',kcpm:'',kcpa:'',khook:'',spend:'',reach:'',impr:'',clicks:'',lpv:'',purch:'',hold:'',...v}}
function cardHTML(c,i){
  const f=(k,lab,ph,tip,type='number')=>`<label title="${tip}">${lab}<input data-f="${k}" type="${type}" ${type==='number'?'min="0" step="any" inputmode="decimal"':''} placeholder="${ph}" value="${esc(c[k])}"></label>`;
  const kp=(k,lab,tip)=>`<label class="kpi" title="${tip}">${lab}<input data-f="${k}" type="number" min="0" step="any" inputmode="decimal" placeholder="auto" value="${esc(c[k])}"></label>`;
  return `<article class="cc a${i%4}" data-id="${c.id}"><div class="cch"><h3>🎬 AD SET ${i+1}</h3><button class="btn sm danger" data-rm ${creatives.length<2?'disabled':''}>Remove Ad Set</button></div>
  <div class="kpih" style="margin-top:0">Fields follow the column order of Meta Ads Manager. CPM, CPC, CTR and CPA can be left empty: they are calculated automatically.</div>
  <div class="fg">${f('adset','Ad Set Name','e.g. KSA Broad','Name of this ad set in Meta Ads Manager','text')}${f('name','Video Name','VIDEO '+(i+1),'A name to recognize the video in this ad set','text')}${f('spend','Amount Spent ($)','e.g. 7.91','Amount spent on this ad set in USD')}${f('reach','Reach','e.g. 1500','People who saw the ad at least once')}
  ${f('impr','Impressions','e.g. 2065','Times the ad was shown')}${kp('kcpm','CPM ($)','Cost per 1,000 impressions')}${f('clicks','Link Clicks','e.g. 17','Clicks on the ad link (not all clicks)')}${kp('kcpc','CPC (Link) ($)','Cost per link click')}
  ${kp('kctr','CTR (Link) (%)','Link click-through rate')}${f('lpv','Landing Page Views','e.g. 15','People whose page fully loaded after the click')}${f('purch','Purchases','e.g. 2','Orders generated')}${kp('kcpa','CPA ($)','Cost per purchase')}
  ${kp('khook','Hook Rate (%)','3-second views / impressions. Type it from Meta.')}${f('hold','Hold Rate (%) optional','e.g. 8','Optional: shown in the report only')}</div><div class="warn" data-w></div><div class="met" data-m></div></article>`;
}
function renderCards(){$('#cards').innerHTML=creatives.map(cardHTML).join('')}
function warns(c){
  const w=[],n=k=>num(c[k]);
  ['spend','reach','impr','clicks','lpv','purch','hold','kctr','kcpc','kcpm','kcpa','khook'].forEach(k=>{if(c[k]!==''&&n(k)==null)w.push(`${k.replace(/^k/,'')}: enter a number of 0 or more.`)});
  if(n('clicks')>n('impr'))w.push('Link clicks cannot be greater than impressions.');
  if(n('lpv')>n('clicks'))w.push('Landing page views cannot be greater than link clicks.');
  if(n('purch')>n('lpv'))w.push('Purchases cannot be greater than landing page views.');
  if(n('reach')>n('impr'))w.push('Reach cannot be greater than impressions.');
  if(n('hold')>100||n('kctr')>100||n('khook')>100)w.push('Percentages cannot exceed 100%.');
  return w;
}
const chip=(l,v,t)=>`<div class="chip ${t}">${l}<b>${v}</b></div>`;
function update(){
  const A=analyse(),G=A.G;L='en';
  A.list.forEach(o=>{
    const el=$(`[data-id="${o.c.id}"]`);if(!el)return;const k=o.k,v=V[o.v];
    el.querySelector('[data-w]').innerHTML=warns(o.c).map(w=>'⚠️ '+esc(w)).join('<br>');
    el.querySelector('[data-m]').innerHTML=(k.s>0||k.i>0)?`<span class="badge ${v.c}">${v.e} ${vl(v)}</span><div style="flex-basis:100%;font-size:13px;color:var(--mut)">${vt(v)}</div>`:`<span style="font-size:13px;color:var(--mut)">Enter spend, impressions and clicks to see this ad set's status.</span>`;
    const au=calc(o.c,1);
    [['ctr','kctr',fp,tCtr],['cpc','kcpc',fm,tCpc],['cpm','kcpm',fm,()=>'n'],['cpa','kcpa',fm,tCpa],['hook','khook',fp,tHook]].forEach(([m,f,fn,tn])=>{const inp=el.querySelector(`[data-f="${f}"]`);inp.placeholder=au[m]==null?(m==='hook'?'e.g. 20':'auto'):'auto '+fn(au[m]);inp.parentNode.className='kpi '+tn(k[m])});
  });
  if(document.activeElement!==$('#cnt'))$('#cnt').value=creatives.length;
  const has=G.s>0||G.i>0;
  $('#results').hidden=!has;$('#empty').hidden=has;
  const R=REC[A.rec],pill=$('#pill');
  pill.className='pill '+(has?R.c:'n');pill.textContent=has?`${R.e} ${vl(R)}`:'Waiting for data';
