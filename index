<script>/* theme: apply the saved choice before anything is painted (no white flash) */
(function(){try{if(localStorage.getItem("cwi-theme")==="dark")document.documentElement.setAttribute("data-theme","dark")}catch(e){}})();</script>
<style>

  /* ============ SHARED GLOBAL RESET (used by both screens) ============ */
  *{box-sizing:border-box;}
  html,body{margin:0; padding:0; height:100%;}
  body{overflow-x:hidden; -webkit-font-smoothing:antialiased;}
  #loginScreen, #dashboardScreen{min-height:100vh;}

  /* ============ ANIMATED LOGO (COD Partner) - shared by login + sidebar ============ */
  .cplogo{display:inline-block; --cp-ink:#0b0a1a; --cp-icon:#642dd8;}
  .cplogo svg{display:block; height:var(--cp-h,34px); width:auto; overflow:visible;}
  .cplogo .cp-icon{fill:var(--cp-icon); transform-origin:57.1px 50px;}
  .cplogo .cp-l{fill:var(--cp-ink);}
  #loginScreen .brand .cplogo{--cp-h:34px; --cp-ink:#fff; --cp-icon:#a98bff;}
  #loginScreen .login .cplogo{--cp-h:36px;}
  html[data-theme="dark"] #loginScreen .login .cplogo{--cp-ink:#f3efff; --cp-icon:#9d7bff;}
  #dashboardScreen .brand .cplogo{--cp-h:30px; --cp-ink:#fff; --cp-icon:#a98bff;}
  @media (prefers-reduced-motion:no-preference){
    .cplogo .cp-icon,.cplogo .cp-l,.cplogo .cp-lock{animation-duration:2.8s; animation-iteration-count:1; animation-fill-mode:both;}
    .cplogo .cp-icon{animation-name:cpIcon; animation-timing-function:cubic-bezier(.2,.8,.2,1);}
    .cplogo .cp-lock{animation-name:cpLock; animation-timing-function:cubic-bezier(.65,0,.35,1);}
    .cplogo .cp-l{animation-timing-function:cubic-bezier(.22,.8,.3,1);}
    .cplogo .cp-l0{animation-name:cpL0;}
    .cplogo .cp-l1{animation-name:cpL1;}
    .cplogo .cp-l2{animation-name:cpL2;}
    .cplogo .cp-l3{animation-name:cpL3;}
    .cplogo .cp-l4{animation-name:cpL4;}
    .cplogo .cp-l5{animation-name:cpL5;}
    .cplogo .cp-l6{animation-name:cpL6;}
    .cplogo .cp-l7{animation-name:cpL7;}
    .cplogo .cp-l8{animation-name:cpL8;}
    .cplogo .cp-l9{animation-name:cpL9;}
  }
  @keyframes cpIcon{0%{opacity:0;transform:scale(1.55)}8%{opacity:.55}19.6%,100%{opacity:1;transform:scale(1)}}
  @keyframes cpLock{0%,53.58%{transform:translateX(175.7px)}85.72%,100%{transform:translateX(0)}}
  @keyframes cpL0{0%,53.58%{opacity:0;transform:translateX(10.0px)}80.36%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL1{0%,55.36%{opacity:0;transform:translateX(16.8px)}82.14%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL2{0%,57.14%{opacity:0;transform:translateX(24.2px)}83.92%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL3{0%,58.92%{opacity:0;transform:translateX(33.8px)}85.72%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL4{0%,60.72%{opacity:0;transform:translateX(39.0px)}87.5%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL5{0%,62.5%{opacity:0;transform:translateX(46.1px)}89.28%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL6{0%,64.28%{opacity:0;transform:translateX(51.2px)}91.08%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL7{0%,66.08%{opacity:0;transform:translateX(56.5px)}92.86%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL8{0%,67.86%{opacity:0;transform:translateX(63.5px)}94.64%,100%{opacity:1;transform:translateX(0)}}
  @keyframes cpL9{0%,69.64%{opacity:0;transform:translateX(68.8px)}96.42%,100%{opacity:1;transform:translateX(0)}}

  /* ============ PROFILE PHOTO (shared by login preview + dashboard avatar) ============ */
  :root{--avatar-photo:url("data:image/webp;base64,");}
  #loginScreen .avatar.avatar-photo, #dashboardScreen .avatar.avatar-photo{
    background:#e9e4f5 var(--avatar-photo) center/cover no-repeat;
    font-size:0; color:transparent;
    box-shadow:0 0 0 2px #9b6bff, 0 6px 14px rgba(124,58,237,.35);
  }

  /* ============ PLATFORM SCREENSHOTS (shared by login + dashboard) ============ */
  .shot{display:block; width:100%; background-size:cover; background-position:center; background-repeat:no-repeat;}
  .shot-laptop{aspect-ratio:1918/983; background-image:url(data:image/webp;base64,);}
  .shot-phone{aspect-ratio:137/296; background-image:url(data:image/webp;base64,);}

  /* ============ LOGIN SCREEN STYLES (scoped to #loginScreen) ============ */
#loginScreen{

    --bg-dark-1:#120e3d;
    --bg-dark-2:#1e1560;
    --bg-dark-3:#3c22a0;
    --bg-dark-4:#6d3ff5;
    --accent:#7a45ff;
    --accent-2:#9b6bff;
    --accent-bright:#8b5cff;
    --lavender:#efe9ff;
    --login-bg:#fdfcff;
    --preview-bg-1:#f3f0ff;
    --preview-bg-2:#ffffff;
    --text-dark:#15123c;
    --text-body:#2b2a55;
    --text-muted:#83809f;
    --border-soft:#eae6fa;
    --green:#1fae6b;
    --green-bg:#e7f8ef;
    --amber:#b8860b;
    --amber-bg:#fdf3dc;
    --radius-lg:26px;
    --radius-md:16px;
    --radius-sm:12px;
    --shadow-card:0 10px 30px rgba(60,40,140,.08);
    --shadow-btn:0 14px 30px rgba(109,63,245,.35);
  
}
#loginScreen *, #loginScreen *::before, #loginScreen *::after{box-sizing:border-box;}
#loginScreen{
    font-family:'Tajawal','Segoe UI',sans-serif;
    background:var(--bg-dark-1);
    color:var(--text-dark);
    overflow-x:hidden;
    -webkit-font-smoothing:antialiased;
  }
#loginScreen a{color:inherit;}
#loginScreen button{font-family:inherit;}
#loginScreen .visually-hidden{
    position:absolute; width:1px; height:1px; overflow:hidden;
    clip:rect(0 0 0 0); white-space:nowrap;
  }
/* ---------- layout ---------- */
#loginScreen .stage{
    display:flex;
    direction:ltr;
    min-height:100vh;
    width:100%;
    align-items:stretch;
  }
#loginScreen .panel{position:relative; direction:rtl;}
/* ================= BRAND PANEL ================= */
#loginScreen .brand{
    flex:0 0 clamp(360px,38vw,620px);
    background:
      radial-gradient(120% 90% at 8% 0%, #241772 0%, transparent 55%),
      radial-gradient(90% 70% at 100% 70%, #6d3ff5 0%, transparent 55%),
      linear-gradient(160deg,var(--bg-dark-1) 0%, var(--bg-dark-2) 45%, var(--bg-dark-3) 100%);
    color:#fff;
    overflow:visible;
    display:flex;
    flex-direction:column;
    padding:clamp(28px,3.2vw,52px) clamp(28px,3.6vw,58px);
    z-index:1;
  }
#loginScreen .brand .glow{position:absolute;inset:0;overflow:hidden;z-index:0;pointer-events:none;}
#loginScreen .glow span{position:absolute;border-radius:50%;filter:blur(60px);opacity:.55;}
#loginScreen .glow .g1{width:340px;height:340px;background:#8b5cff;top:-120px;left:-90px;}
#loginScreen .glow .g2{width:420px;height:420px;background:#3c22a0;bottom:-160px;left:20%;opacity:.6;}
#loginScreen .glow .g3{width:260px;height:260px;background:#a685ff;top:40%;right:-100px;opacity:.35;}
#loginScreen .brand > *{position:relative;z-index:1;}
#loginScreen .curve{
    position:absolute; top:0; right:0; height:100%;
    width:clamp(60px,7vw,110px);
    transform:translateX(50%);
    z-index:5; pointer-events:none;
  }
#loginScreen .curve svg{display:block;width:100%;height:100%;}
#loginScreen .mobile-curve{display:none;}
#loginScreen .logo{
    display:flex; align-items:baseline; gap:8px;
    font-family:'Poppins',sans-serif;
    direction:ltr;
  }
#loginScreen .logo .mark{font-weight:800; font-size:26px; letter-spacing:-.5px;}
#loginScreen .logo .mark em{font-style:normal; color:var(--accent-bright);}
#loginScreen .logo .tail{font-weight:400; font-size:19px; color:#cfc4ff; letter-spacing:.2px;}
#loginScreen .brand .logo{margin-bottom:clamp(22px,3vw,40px);}
#loginScreen .badge{
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(255,255,255,.1);
    border:1px solid rgba(255,255,255,.18);
    backdrop-filter:blur(4px);
    padding:8px 16px; border-radius:999px;
    font-size:13px; font-weight:700; color:#f1ecff;
    width:fit-content;
    margin-bottom:22px;
  }
#loginScreen .badge svg{width:14px;height:14px;fill:#ffd36b;}
#loginScreen .brand h1{
    font-size:clamp(26px,2.6vw,36px);
    line-height:1.45;
    font-weight:800;
    margin:0 0 16px;
    max-width:15ch;
  }
#loginScreen .brand h1 .hl{color:#c9b6ff;}
#loginScreen .brand p.lede{
    font-size:15px; line-height:1.9; color:#b8b2d9;
    max-width:38ch; margin:0 0 clamp(24px,3vw,36px);
    font-weight:400;
  }
#loginScreen .stats{
    display:flex; align-items:center; gap:18px;
    margin-bottom:clamp(28px,4vw,46px);
    flex-wrap:wrap;
    direction:ltr;
  }
#loginScreen .stat{display:flex; flex-direction:column; align-items:center; gap:6px; min-width:64px;}
#loginScreen .stat svg{width:18px;height:18px; fill:none; stroke:#c9b6ff; stroke-width:1.8;}
#loginScreen .stat b{font-size:22px; font-weight:800; color:#fff;}
#loginScreen .stat span{font-size:12px; color:#a9a3cf; font-weight:500;}
#loginScreen .stat-div{width:1px; height:34px; background:rgba(255,255,255,.18);}
#loginScreen .device-area{
    position:relative;
    flex:1;
    min-height:230px;
    margin-bottom:22px;
  }
#loginScreen .sticky-note{
    position:absolute; top:0; left:1%; z-index:6; max-width:44%;
    font-family:'Caveat',cursive; color:#fff;
    font-size:clamp(15px,1.5vw,21px); line-height:1.12; font-weight:600;
    transform:rotate(-4deg);
    text-shadow:0 2px 10px rgba(0,0,0,.25);
  }
#loginScreen .sticky-note svg{width:40px;height:26px;stroke:#fff;fill:none;stroke-width:2; margin-top:2px; margin-right:auto;}
#loginScreen .device-mock{
    position:absolute; bottom:0; right:0; left:0;
    display:flex; justify-content:center; align-items:flex-end;
    height:100%;
    padding-top:clamp(74px,10vw,100px);
  }
#loginScreen .rig{position:relative; width:min(70%,320px);}
#loginScreen .laptop{
    background:linear-gradient(160deg,#232048,#15132f);
    border-radius:14px; padding:9px 9px 12px;
    box-shadow:0 30px 60px rgba(0,0,0,.5);
  }
#loginScreen .laptop-screen{
    background:#fff; border-radius:9px; overflow:hidden; direction:ltr;
  }
#loginScreen .laptop-base{
    height:9px; margin-top:-2px;
    background:linear-gradient(180deg,#2c2954,#171533);
    border-radius:0 0 10px 10px;
  }
#loginScreen .phone{
    position:absolute; right:-4%; bottom:-6%; z-index:2;
    width:23%;
    background:#181633; border-radius:15px; padding:4px;
    box-shadow:0 20px 40px rgba(0,0,0,.5);
  }
#loginScreen .phone-screen{border-radius:11px; overflow:hidden; direction:ltr;}
#loginScreen .pot{
    position:absolute; left:-11%; top:6%; width:17%; z-index:1;
  }
#loginScreen .pot svg{width:100%;height:auto;}
#loginScreen .mug{
    position:absolute; right:-20%; bottom:-16%; width:15%; z-index:3;
  }
#loginScreen .mug .cup{
    background:linear-gradient(160deg,#242150,#141230);
    border-radius:6px 6px 10px 10px; aspect-ratio:1/1.05;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 14px 26px rgba(0,0,0,.45);
    position:relative;
  }
#loginScreen .mug .cup::after{
    content:''; position:absolute; right:-28%; top:22%; width:38%; height:40%;
    border:3px solid #242150; border-inline-start:none; border-radius:0 40% 40% 0;
  }
#loginScreen .mug .cup span{font-family:'Poppins',sans-serif; color:#fff; font-size:9px; font-weight:700;}
#loginScreen .whatsapp-btn{
    display:inline-flex; align-items:center; gap:10px;
    background:linear-gradient(135deg,#7a45ff,#9b6bff);
    color:#fff; font-weight:700; font-size:14px;
    padding:13px 22px; border-radius:999px; border:none; cursor:pointer;
    box-shadow:0 16px 30px rgba(122,69,255,.4);
    width:fit-content; transition:transform .15s ease, box-shadow .15s ease;
  }
#loginScreen .whatsapp-btn:hover{transform:translateY(-2px); box-shadow:0 20px 36px rgba(122,69,255,.5);}
#loginScreen .whatsapp-btn svg{width:18px;height:18px;fill:#fff;}
/* ================= LOGIN PANEL ================= */
#loginScreen .login{
    flex:0 0 clamp(380px,32vw,540px);
    background:var(--login-bg);
    display:flex; align-items:center; justify-content:center;
    padding:32px clamp(28px,3.4vw,56px);
    z-index:2;
  }
#loginScreen .login-inner{width:100%; max-width:400px;}
#loginScreen .login .logo .mark{color:var(--text-dark);}
#loginScreen .login .logo .mark em{color:var(--accent);}
#loginScreen .login .logo .tail{color:#9c98b8;}
#loginScreen .login .logo{margin-bottom:clamp(30px,4vw,52px);}
#loginScreen .login h2{
    font-size:clamp(24px,2.4vw,30px); font-weight:800; margin:0 0 8px; color:var(--text-dark);
  }
#loginScreen .login p.sub{
    font-size:14px; color:var(--text-muted); margin:0 0 clamp(26px,3vw,34px); line-height:1.7;
  }
#loginScreen .field{margin-bottom:18px;}
#loginScreen .field-label-row{
    display:flex; justify-content:space-between; align-items:center; margin-bottom:9px;
  }
#loginScreen .field-label-row label{font-size:13.5px; font-weight:700; color:var(--text-dark);}
#loginScreen .mini-badge{
    display:inline-flex; align-items:center; gap:4px;
    background:var(--green-bg); color:var(--green);
    font-size:11px; font-weight:700; padding:3px 10px; border-radius:999px;
  }
#loginScreen .mini-badge svg{width:10px;height:10px;fill:var(--green);}
#loginScreen .input-wrap{
    display:flex; align-items:center; gap:10px;
    background:#f7f6fc; border:1.5px solid var(--border-soft);
    border-radius:var(--radius-sm); padding:0 16px; height:54px;
    transition:border-color .15s ease, box-shadow .15s ease, background .15s ease;
    direction:ltr;
  }
#loginScreen .input-wrap:focus-within{
    border-color:var(--accent); background:#fff;
    box-shadow:0 0 0 4px rgba(122,69,255,.12);
  }
#loginScreen .input-wrap svg.i-lead{width:18px;height:18px; stroke:#9c98b8; fill:none; stroke-width:1.7; flex:none;}
#loginScreen .input-wrap input{
    border:none; outline:none; background:transparent; flex:1; min-width:0;
    font-size:14.5px; color:var(--text-dark); font-family:'Tajawal','Poppins',sans-serif;
    height:100%;
  }
#loginScreen .input-wrap input::placeholder{color:#b3afc9;}
#loginScreen #email{direction:ltr; text-align:left; font-family:'Poppins',sans-serif; font-size:14px;}
#loginScreen #password{direction:ltr; text-align:left; font-family:'Poppins',sans-serif; letter-spacing:2px;}
#loginScreen #password::-ms-reveal,
#loginScreen #password::-ms-clear{display:none;}
#loginScreen .eye-btn{
    background:none; border:none; cursor:pointer; padding:4px; display:flex; flex:none;
  }
#loginScreen .eye-btn svg{width:19px;height:19px; stroke:#9c98b8; fill:none; stroke-width:1.7;}
#loginScreen .field-error{
    display:none; color:#d64545; font-size:12px; margin-top:7px; font-weight:600;
  }
#loginScreen .field.invalid .input-wrap{border-color:#e58a8a; background:#fff6f6;}
#loginScreen .field.invalid .field-error{display:block;}
#loginScreen .login-btn{
    width:100%; height:56px; border:none; border-radius:var(--radius-sm);
    background:linear-gradient(120deg,#6d3ff5,#8b5cff);
    color:#fff; font-size:16px; font-weight:800; cursor:pointer;
    box-shadow:var(--shadow-btn);
    margin-top:8px;
    display:flex; align-items:center; justify-content:center; gap:10px;
    transition:transform .15s ease, box-shadow .15s ease, opacity .15s ease;
  }
#loginScreen .login-btn:hover{transform:translateY(-2px); box-shadow:0 18px 34px rgba(109,63,245,.42);}
#loginScreen .login-btn:disabled{opacity:.75; cursor:progress; transform:none;}
#loginScreen .spinner{
    width:17px;height:17px;border-radius:50%;
    border:2.5px solid rgba(255,255,255,.4); border-top-color:#fff;
    animation:loginSpin .7s linear infinite; display:none;
  }
#loginScreen .login-btn.loading .spinner{display:inline-block;}
#loginScreen .login-btn.loading .btn-label{opacity:.85;}
@keyframes loginSpin{to{transform:rotate(360deg);}}
#loginScreen .status-card{
    margin-top:18px;
    display:flex; align-items:center; justify-content:space-between; gap:12px;
    background:#f8f6ff; border:1px solid var(--border-soft);
    border-radius:var(--radius-sm); padding:14px 16px;
    transition:opacity .2s ease, transform .2s ease;
  }
#loginScreen .status-text b{display:block; font-size:13.5px; color:var(--text-dark); margin-bottom:2px;}
#loginScreen .status-text span{font-size:12px; color:var(--text-muted);}
#loginScreen .status-icon{
    width:30px;height:30px;border-radius:50%; background:var(--green-bg);
    display:flex; align-items:center; justify-content:center; flex:none;
  }
#loginScreen .status-icon svg{width:15px;height:15px; stroke:var(--green); fill:none; stroke-width:2.4;}
#loginScreen .toast-success{
    display:none; margin-top:16px; align-items:center; gap:10px;
    background:var(--green-bg); color:var(--green); font-weight:700; font-size:13.5px;
    padding:12px 16px; border-radius:var(--radius-sm);
  }
#loginScreen .toast-success.show{display:flex;}
#loginScreen .toast-success svg{width:16px;height:16px; stroke:var(--green); fill:none; stroke-width:2.4;}
/* ================= PREVIEW PANEL ================= */
#loginScreen .preview{
    flex:1 1 340px;
    background:linear-gradient(170deg,var(--preview-bg-1),var(--preview-bg-2) 55%);
    padding:clamp(22px,2.6vw,36px);
    display:flex; flex-direction:column; gap:16px;
    min-width:0;
  }
#loginScreen .p-topbar{display:flex; align-items:center; justify-content:space-between; gap:10px;}
#loginScreen .p-icons{display:flex; align-items:center; gap:14px;}
#loginScreen .icon-btn{
    position:relative; width:38px;height:38px;border-radius:50%;background:#fff;
    display:flex;align-items:center;justify-content:center; box-shadow:var(--shadow-card);
  }
#loginScreen .icon-btn svg{width:17px;height:17px; stroke:#4c4770; fill:none; stroke-width:1.8;}
#loginScreen .icon-btn .dot{position:absolute; top:7px; left:8px; width:7px;height:7px;border-radius:50%;background:#ef4b4b; border:1.5px solid #fff;}
#loginScreen .p-user{display:flex; align-items:center; gap:10px;}
#loginScreen .p-user .txt{text-align:right;}
#loginScreen .p-user .txt b{display:block; font-size:12.5px; color:var(--text-dark);}
#loginScreen .p-user .txt span{font-size:11px; color:var(--text-muted); direction:ltr; display:block; unicode-bidi:plaintext;}
#loginScreen .avatar{
    width:38px;height:38px;border-radius:50%;
    background:linear-gradient(135deg,#7a45ff,#9b6bff); color:#fff;
    display:flex;align-items:center;justify-content:center; font-weight:800; font-size:14px;
    font-family:'Poppins',sans-serif;
  }
#loginScreen .p-hand{
    font-family:'Caveat',cursive; color:var(--accent); font-size:22px; font-weight:700;
    display:flex; align-items:center; gap:6px; align-self:flex-start;
  }
#loginScreen .p-hand svg{width:26px;height:20px;stroke:var(--accent);fill:none;stroke-width:2;}
#loginScreen .growth-card{
    background:#fff; border-radius:var(--radius-md); padding:16px 18px;
    display:flex; align-items:center; gap:12px; box-shadow:var(--shadow-card);
  }
#loginScreen .growth-ico{
    width:38px;height:38px;border-radius:50%;background:var(--green-bg);
    display:flex;align-items:center;justify-content:center; flex:none;
  }
#loginScreen .growth-ico svg{width:17px;height:17px; stroke:var(--green); fill:none; stroke-width:2.2;}
#loginScreen .growth-card b{font-size:19px; color:var(--text-dark); display:block;}
#loginScreen .growth-card span{font-size:12px; color:var(--text-muted);}
#loginScreen .section-head{display:flex; align-items:center; justify-content:space-between;}
#loginScreen .section-head h3{font-size:14.5px; font-weight:800; color:var(--text-dark); margin:0;}
#loginScreen .dots-menu{display:flex; gap:3px;}
#loginScreen .dots-menu span{width:3.5px;height:3.5px;border-radius:50%;background:#b7b3cf;}
#loginScreen .pager-dots{display:flex; gap:5px; margin-top:-6px;}
#loginScreen .pager-dots span{width:5px;height:5px;border-radius:50%;background:#ddd8f0;}
#loginScreen .pager-dots span:first-child{background:var(--accent); width:14px; border-radius:4px;}
#loginScreen .stat-grid{display:flex; gap:10px;}
#loginScreen .mini-stat{
    flex:1; background:#fff; border-radius:var(--radius-md); padding:13px 12px;
    box-shadow:var(--shadow-card); min-width:0;
  }
#loginScreen .mini-stat span.lbl{font-size:11px; color:var(--text-muted); display:block; margin-bottom:6px;}
#loginScreen .mini-stat b{font-size:17px; color:var(--text-dark); display:block;}
#loginScreen .mini-stat .cur{font-size:10px; color:var(--text-muted); font-weight:500;}
#loginScreen .mini-stat .trend{
    display:inline-flex; align-items:center; gap:3px; margin-top:6px;
    background:var(--green-bg); color:var(--green); font-size:10.5px; font-weight:700;
    padding:2px 7px; border-radius:999px;
  }
#loginScreen .mini-stat .trend svg{width:8px;height:8px; stroke:var(--green); fill:none; stroke-width:3;}
#loginScreen .chart-card{
    background:#fff; border-radius:var(--radius-md); padding:16px; box-shadow:var(--shadow-card);
  }
#loginScreen .chart-top{display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;}
#loginScreen .chart-select{
    display:flex; align-items:center; gap:5px; font-size:11.5px; color:var(--text-muted);
    background:#f6f4fc; padding:5px 10px; border-radius:999px; font-weight:600;
  }
#loginScreen .chart-select svg{width:9px;height:9px; stroke:var(--text-muted); fill:none; stroke-width:2;}
#loginScreen .chart-card svg.trend-line{width:100%; height:70px; margin-top:6px;}
#loginScreen .chart-note{font-size:11px; color:var(--text-muted); margin:6px 2px 0;}
#loginScreen .orders-head{display:flex; align-items:center; justify-content:space-between;}
#loginScreen .view-all{font-size:12px; color:var(--accent); font-weight:700; text-decoration:none;}
#loginScreen .orders-list{display:flex; flex-direction:column; gap:9px;}
#loginScreen .mobile-preview-card{display:none;}
#loginScreen .order-row{
    display:flex; align-items:center; justify-content:space-between; gap:10px;
    background:#fff; border-radius:var(--radius-sm); padding:11px 14px; box-shadow:var(--shadow-card);
  }
#loginScreen .order-row .who{display:flex; align-items:center; gap:9px;}
#loginScreen .order-row .flag{font-size:16px;}
#loginScreen .order-row .who b{display:block; font-size:12.5px; color:var(--text-dark);}
#loginScreen .order-row .who span{font-size:11px; color:var(--text-muted);}
#loginScreen .pill{font-size:10.5px; font-weight:700; padding:5px 11px; border-radius:999px; white-space:nowrap;}
#loginScreen .pill.green{background:var(--green-bg); color:var(--green);}
#loginScreen .pill.amber{background:var(--amber-bg); color:var(--amber);}
#loginScreen .products-row{display:flex; gap:10px;}
#loginScreen .product-card{
    flex:1; background:#fff; border-radius:var(--radius-md); padding:12px;
    display:flex; align-items:center; gap:10px; box-shadow:var(--shadow-card); min-width:0;
  }
#loginScreen .product-emoji{
    width:40px;height:40px;border-radius:12px; background:var(--lavender);
    display:flex;align-items:center;justify-content:center; font-size:19px; flex:none;
  }
#loginScreen .product-info{min-width:0;}
#loginScreen .product-badge{
    font-size:10px; font-weight:700; color:var(--accent); background:var(--lavender);
    padding:2px 8px; border-radius:999px; display:inline-block; margin-bottom:4px;
  }
#loginScreen .product-info div{font-size:11.5px; font-weight:700; color:var(--green);}
/* ================= RESPONSIVE ================= */
@media (max-width:1180px){
#loginScreen .preview{display:none;}
#loginScreen .login{flex:1 1 auto;}
}
@media (max-width:820px){
#loginScreen .stage{flex-direction:column;}
#loginScreen .curve{display:none;}
#loginScreen .brand{
      flex:0 0 auto; padding:26px 24px; min-height:0;
      position:relative; padding-bottom:44px;
    }
#loginScreen .mobile-curve{
      display:block; position:absolute; left:0; right:0; bottom:-1px;
      height:clamp(28px,9vw,46px); z-index:5; pointer-events:none;
    }
