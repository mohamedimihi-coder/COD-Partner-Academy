#loginScreen .device-area, #loginScreen .stats{display:none;}
#loginScreen .badge{margin-bottom:16px;}
#loginScreen .brand h1{max-width:none; margin-bottom:6px; font-size:22px;}
#loginScreen .whatsapp-btn{margin-top:14px;}
#loginScreen .login{flex:1 1 auto; padding:36px 22px;}
#loginScreen .mobile-preview-card{
      display:flex; flex-direction:column; gap:16px;
      margin-top:26px; padding-top:22px; border-top:1px solid #ece7fa;
    }
#loginScreen .mobile-preview-card .view-all{align-self:center; font-size:13px;}
#loginScreen .chart-card-title{font-size:12.5px; font-weight:700; color:var(--text-dark);}
#loginScreen .mobile-preview-card .stat-grid{margin-top:14px; flex-wrap:wrap;}
#loginScreen .mobile-preview-card .mini-stat{flex:1 1 calc(33.333% - 8px); min-width:96px;}
#loginScreen .guest-link{
      align-self:center; display:inline-flex; align-items:center; gap:8px;
      font-size:13px; font-weight:600; color:var(--text-muted);
    }
#loginScreen .guest-link svg{width:16px; height:16px; stroke:var(--text-muted); fill:none; stroke-width:1.8;}
}
@media (max-width:420px){
#loginScreen .login-inner{max-width:100%;}
}

  /* ============ DASHBOARD SCREEN STYLES (scoped to #dashboardScreen) ============ */
#dashboardScreen{

    --purple-950:#170733;
    --purple-900:#22103f;
    --purple-850:#2b1552;
    --purple-700:#4c1d95;
    --purple-600:#6d28d9;
    --purple-500:#7c3aed;
    --purple-400:#9c6bf0;
    --purple-300:#c6a9f7;
    --purple-200:#e1d3fb;
    --purple-100:#ede4fc;
    --purple-50:#f7f3fe;
    --ink:#271447;
    --muted:#8478a3;
    --muted-2:#a99bc7;
    --green:#1fae60;
    --green-bg:#e6f8ee;
    --gray-400:#9a93ad;
    --gray-bg:#f1eef6;
    --white:#ffffff;
    --radius-xl:28px;
    --radius-lg:20px;
    --radius-md:14px;
    --shadow-sm:0 2px 10px rgba(76,29,149,.06);
    --shadow-md:0 10px 30px rgba(76,29,149,.12);
    --font-ar:'Tajawal', 'Segoe UI', system-ui, sans-serif;
    --font-hand:'Caveat', cursive;
  
}
#dashboardScreen *{box-sizing:border-box; margin:0; padding:0;}
#dashboardScreen{
    font-family:var(--font-ar);
    color:var(--ink);
    background:#fbfaff;
    -webkit-font-smoothing:antialiased;
    overflow-x:hidden;
  }
#dashboardScreen ul{list-style:none;}
#dashboardScreen a{color:inherit; text-decoration:none;}
#dashboardScreen button{font-family:inherit; cursor:pointer; border:none; background:none; color:inherit;}
#dashboardScreen input{font-family:inherit;}
#dashboardScreen svg{display:block;}
#dashboardScreen .icon{width:20px; height:20px; flex-shrink:0;}
/* ============ APP SHELL ============ */
#dashboardScreen .app-shell{
    display:flex;
    direction:ltr; /* physical placement only: sidebar -> left, main -> right, matching the screenshot */
    min-height:100vh;
    width:100%;
  }
/* ============ SIDEBAR ============ */
#dashboardScreen .sidebar{
    direction:rtl;
    width:272px;
    flex-shrink:0;
    min-height:100vh;
    background:
      radial-gradient(420px 260px at 90% 0%, rgba(255,255,255,.06), transparent 60%),
      radial-gradient(360px 240px at 10% 100%, rgba(124,58,237,.35), transparent 60%),
      linear-gradient(180deg, var(--purple-900) 0%, var(--purple-950) 65%, #12061f 100%);
    color:#fff;
    display:flex;
    flex-direction:column;
    justify-content:space-between;
    padding:26px 20px 24px;
    position:relative;
    z-index:20;
    transition:transform .25s ease;
  }
#dashboardScreen .sidebar-top{display:flex; flex-direction:column; gap:34px;}
#dashboardScreen .brand{direction:ltr; display:flex; align-items:center; gap:12px; padding:0 6px;}
#dashboardScreen .brand-logo{
    width:42px; height:42px; border-radius:12px;
    background:#fff; color:var(--purple-600);
    display:flex; align-items:center; justify-content:center;
    font-weight:900; font-size:20px;
    box-shadow:0 4px 12px rgba(0,0,0,.2);
  }
#dashboardScreen .brand-text{display:flex; flex-direction:column; line-height:1.3;}
#dashboardScreen .brand-name{font-weight:800; font-size:17px; color:#fff;}
#dashboardScreen .brand-sub{font-size:11.5px; color:var(--muted-2); font-weight:500;}
#dashboardScreen .nav{display:flex; flex-direction:column; gap:6px;}
#dashboardScreen .nav-item{
    display:flex; align-items:center; gap:12px;
    padding:12px 14px;
    border-radius:14px;
    color:#c8b9ec;
    font-size:14.5px; font-weight:500;
    transition:background .15s ease, color .15s ease, transform .15s ease;
  }
#dashboardScreen .nav-item{direction:ltr; text-align:left;}
#dashboardScreen .nav-item .icon{color:inherit; opacity:.9;}
#dashboardScreen .nav-item:hover{background:rgba(255,255,255,.07); color:#fff;}
#dashboardScreen .nav-item.active{
    background:linear-gradient(90deg, var(--purple-500), #9333ea);
    color:#fff;
    font-weight:700;
    box-shadow:0 10px 22px rgba(124,58,237,.45);
  }
#dashboardScreen .sidebar-bottom{display:flex; flex-direction:column; gap:14px;}
#dashboardScreen .promo-card{
    background:linear-gradient(155deg, var(--purple-500) 0%, #6425c4 55%, #4c1d95 100%);
    border-radius:18px;
    padding:18px;
    position:relative;
    overflow:hidden;
  }
#dashboardScreen .promo-card::after{
    content:"";
    position:absolute; inset:0;
    background:radial-gradient(120px 90px at 90% -10%, rgba(255,255,255,.25), transparent 70%);
  }
#dashboardScreen .promo-icon{
    width:34px; height:34px; border-radius:10px;
    background:rgba(255,255,255,.18);
    display:flex; align-items:center; justify-content:center;
    margin-bottom:12px;
    color:#fff;
  }
#dashboardScreen .promo-title{font-size:14.5px; font-weight:800; color:#fff; line-height:1.45; margin-bottom:6px;}
#dashboardScreen .promo-sub{font-size:12px; color:#e7dbfb; line-height:1.5; font-weight:500;}
#dashboardScreen .logout-btn{
    display:flex; align-items:center; justify-content:center; gap:10px;
    width:100%;
    padding:12px;
    border-radius:14px;
    border:1px solid rgba(255,255,255,.16);
    background:rgba(255,255,255,.04);
    color:#e9dffc;
    font-size:14px; font-weight:600;
    transition:background .15s ease;
  }
#dashboardScreen .logout-btn:hover{background:rgba(255,255,255,.09);}
#dashboardScreen .mobile-home-cta{display:none;}
/* mobile menu toggle (hidden on desktop) */
#dashboardScreen .menu-toggle{
    display:none;
    width:40px; height:40px; border-radius:12px;
    background:var(--white); box-shadow:var(--shadow-sm);
    align-items:center; justify-content:center;
    color:var(--ink);
  }
#dashboardScreen .sidebar-backdrop{display:none;}
/* ============ MAIN AREA ============ */
#dashboardScreen .main-area{
    direction:rtl;
    flex:1;
    min-width:0;
    background:
      radial-gradient(700px 420px at 85% -10%, rgba(196,169,247,.35), transparent 60%),
      linear-gradient(180deg,#f5f1fd 0%, #fbfaff 30%, #ffffff 100%);
  }
/* ---- Topbar ---- */
#dashboardScreen .topbar{
    display:flex; align-items:center; gap:18px;
    padding:26px 40px 10px;
  }
#dashboardScreen .topbar .spacer{flex:1;}
#dashboardScreen .header-actions{display:flex; align-items:center; gap:16px;}
#dashboardScreen .icon-btn{
    position:relative;
    width:44px; height:44px; border-radius:14px;
    background:var(--white);
    box-shadow:var(--shadow-sm);
    display:flex; align-items:center; justify-content:center;
    color:#6b5c8a;
    transition:box-shadow .15s ease, transform .15s ease;
  }
#dashboardScreen .icon-btn:hover{box-shadow:var(--shadow-md); transform:translateY(-1px);}
#dashboardScreen .icon-btn .dot{
    position:absolute; top:9px; left:9px;
    width:8px; height:8px; border-radius:50%;
    background:#ef4444; border:2px solid #fff;
  }
#dashboardScreen .user-block{display:flex; align-items:center; gap:12px;}
#dashboardScreen .user-info{display:flex; flex-direction:column; align-items:flex-end; line-height:1.35;}
#dashboardScreen .user-role{font-size:11.5px; color:var(--muted); font-weight:600;}
#dashboardScreen .user-email{font-size:13.5px; color:var(--ink); font-weight:700;}
#dashboardScreen .avatar-wrap{display:flex; align-items:center; gap:6px; position:relative;}
#dashboardScreen .avatar{
    width:40px; height:40px; border-radius:50%;
    background:linear-gradient(135deg, var(--purple-500), #d946ef);
    color:#fff; font-weight:800; font-size:15px;
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 6px 14px rgba(124,58,237,.35);
  }
#dashboardScreen .chev{color:var(--muted); transition:transform .15s ease; width:15px; height:15px;}
#dashboardScreen .avatar-wrap[aria-expanded="true"] .chev{transform:rotate(180deg);}
#dashboardScreen .dropdown-panel{
    position:absolute; top:52px; left:0;
    background:#fff; border-radius:14px; box-shadow:var(--shadow-md);
    padding:8px; min-width:170px;
    display:none; flex-direction:column; gap:2px;
    z-index:60;
  }
#dashboardScreen .dropdown-panel.open{display:flex;}
#dashboardScreen .dropdown-panel button, #dashboardScreen .dropdown-panel a{
    text-align:right; padding:10px 12px; border-radius:10px; font-size:13.5px; font-weight:600; color:var(--ink);
  }
#dashboardScreen .dropdown-panel button:hover, #dashboardScreen .dropdown-panel a:hover{background:var(--purple-50);}
#dashboardScreen .notif-panel{min-width:230px;}
#dashboardScreen .notif-panel .notif-title{font-size:12px; font-weight:800; color:var(--muted); padding:6px 10px;}
#dashboardScreen .notif-item{padding:10px; border-radius:10px; font-size:12.5px; color:var(--ink); line-height:1.5;}
#dashboardScreen .notif-item:hover{background:var(--purple-50);}
/* ---- Hero ---- */
#dashboardScreen .content{padding:14px 40px 48px;}
#dashboardScreen .hero{
    position:relative;
    direction:ltr; /* physical split: text block left, visual center, floating cards right */
    display:flex;
    align-items:center;
    gap:24px;
    border-radius:var(--radius-xl);
    min-height:360px;
    padding:38px 46px;
    overflow:hidden;
    background:
      radial-gradient(500px 320px at 15% 20%, rgba(255,255,255,.55), transparent 55%),
      radial-gradient(420px 300px at 85% 80%, rgba(124,58,237,.28), transparent 60%),
      linear-gradient(120deg, #efe7fb 0%, #ddcdf7 45%, #cabaf2 100%);
  }
#dashboardScreen .hero-text{
    direction:rtl;
    position:relative;
    z-index:5;
    width:38%;
    min-width:320px;
    text-align:right;
  }
#dashboardScreen .hero-badge{
    direction:rtl;
    display:inline-flex; align-items:center; gap:8px;
    background:rgba(255,255,255,.85);
    color:var(--purple-600);
    font-size:12.5px; font-weight:700;
    padding:8px 16px; border-radius:999px;
    box-shadow:var(--shadow-sm);
    margin-bottom:20px;
  }
#dashboardScreen .hero-badge .icon{width:15px; height:15px;}
#dashboardScreen .hero h1{
    font-size:32px; line-height:1.35; font-weight:900;
    color:var(--purple-900);
    margin-bottom:16px;
  }
#dashboardScreen .hero p{
    font-size:14.5px; line-height:1.85; color:#5b4d7d; font-weight:500;
    max-width:34ch;
    margin-bottom:26px;
  }
#dashboardScreen .hero-stats{direction:ltr; display:flex; flex-wrap:wrap; gap:10px;}
#dashboardScreen .stat-pill{
    direction:rtl;
    display:flex; align-items:center; gap:8px;
    background:rgba(255,255,255,.9);
    color:var(--ink);
    font-size:12.5px; font-weight:700;
    padding:9px 14px; border-radius:999px;
    box-shadow:var(--shadow-sm);
    white-space:nowrap;
  }
#dashboardScreen .stat-pill .icon{width:15px; height:15px; color:var(--purple-500);}
#dashboardScreen .hero-visual{
    flex:0 0 380px;
    position:relative;
    height:270px;
    z-index:4;
  }
/* platform devices (laptop + phone screenshots) */
#dashboardScreen .hero-devices{position:absolute; left:50%; bottom:26px; transform:translateX(-50%); width:min(372px,100%); z-index:3;}
#dashboardScreen .hd-laptop{position:relative; width:86%;}
#dashboardScreen .hd-laptop-screen{
    background:#1c1030;
    border:3px solid #2a1a45;
    border-radius:12px 12px 3px 3px;
    padding:5px 5px 7px;
    box-shadow:0 30px 50px rgba(30,10,60,.35);
  }
#dashboardScreen .hd-laptop-screen .shot{border-radius:5px;}
#dashboardScreen .hd-laptop-base{
    height:11px; width:110%; margin-left:-5%;
    background:linear-gradient(180deg,#3a2660,#241344);
    border-radius:0 0 10px 10px;
  }
#dashboardScreen .hd-phone{
    position:absolute; right:0; bottom:-8px; width:19%; z-index:2;
    background:#1c1030; border:3px solid #1c1030; border-radius:14px; overflow:hidden;
    box-shadow:0 18px 32px rgba(30,10,60,.4);
  }
#dashboardScreen .hero-side{
    flex:0 0 200px;
    position:relative;
    height:270px;
    z-index:6;
  }
#dashboardScreen .hero-floats{position:absolute; inset:0;}
#dashboardScreen .float-card{
    direction:rtl;
    position:absolute;
    display:flex; align-items:center; gap:8px;
    background:#fff; border-radius:14px;
    padding:10px 14px;
    font-size:12px; font-weight:700; color:var(--ink);
    box-shadow:var(--shadow-md);
    white-space:nowrap;
  }
#dashboardScreen .float-card .icon{width:16px; height:16px; color:var(--purple-500);}
#dashboardScreen .float-card.f1{top:96px; left:0;}
#dashboardScreen .float-card.f2{top:150px; left:14px;}
#dashboardScreen .float-card.f3{top:204px; left:30px;}
#dashboardScreen .hero-tagline{
    position:absolute; top:0; left:6px; right:0;
    font-family:var(--font-hand);
    font-size:25px; line-height:1.15; font-weight:700;
    color:#3b1774;
    text-align:center;
    transform:rotate(-4deg);
  }
#dashboardScreen .hero-tagline .arrow{display:block; width:56px; margin:4px auto 0; color:var(--purple-600); opacity:.7;}
/* ---- Toolbar ---- */
#dashboardScreen .toolbar{
    direction:ltr; /* physical order: search left, filters progressively right, matching screenshot */
    display:flex; align-items:center; gap:16px;
    margin-top:26px;
  }
#dashboardScreen .search-box{
    direction:rtl;
    position:relative;
    flex:1;
    background:#fff;
    border-radius:16px;
    box-shadow:var(--shadow-sm);
  }
#dashboardScreen .search-box .icon{
    position:absolute; top:50%; right:20px; transform:translateY(-50%);
    color:var(--muted); width:19px; height:19px;
  }
#dashboardScreen .search-box input{
    width:100%;
    border:none; outline:none; background:transparent;
    padding:16px 54px 16px 20px;
    font-size:14px; font-weight:500; color:var(--ink);
    text-align:right;
  }
#dashboardScreen .search-box input::placeholder{color:var(--gray-400);}
#dashboardScreen .filter-btn{
    direction:rtl;
    display:flex; align-items:center; gap:10px;
    background:#fff;
    padding:14px 18px;
    border-radius:14px;
    box-shadow:var(--shadow-sm);
    font-size:13.5px; font-weight:700; color:var(--ink);
    white-space:nowrap;
    position:relative;
  }
#dashboardScreen .filter-btn .icon{width:17px; height:17px; color:var(--purple-500);}
#dashboardScreen .filter-btn .chev{width:15px; height:15px;}
#dashboardScreen .filter-btn .dd{
    direction:rtl;
    position:absolute; top:52px; right:0; left:auto;
  }
/* ---- Video grid ---- */
#dashboardScreen .video-grid{
    direction:ltr; /* physical placement: card 01 left-most column, matching screenshot */
    display:grid;
    grid-template-columns:repeat(3, 1fr);
    gap:24px;
    margin-top:28px;
  }
#dashboardScreen .video-card{
    direction:rtl;
    background:#fff;
    border-radius:var(--radius-lg);
    overflow:hidden;
    box-shadow:var(--shadow-sm);
    transition:box-shadow .2s ease, transform .2s ease;
    display:flex; flex-direction:column;
  }
#dashboardScreen .video-card:hover{box-shadow:var(--shadow-md); transform:translateY(-3px);}
#dashboardScreen .video-card.is-hidden{display:none;}
#dashboardScreen .thumb{position:relative; height:186px; overflow:hidden;}
#dashboardScreen .thumb svg.thumb-illus{position:absolute; inset:0; width:100%; height:100%;}
#dashboardScreen .thumb-1{background:linear-gradient(135deg,#efe7fb,#f6ecdf);}
#dashboardScreen .thumb-2{background:linear-gradient(135deg,#241344,#3d1f66);}
#dashboardScreen .thumb-3{background:linear-gradient(135deg,#12081f,#241344);}
