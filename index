<script>
/* ==========================================================================
   COACHING REQUEST — isolated (own IIFE, no globals, only touches #coachingSection)
   Builds the WhatsApp link from the LATEST textarea content + ticked skills.
   The button is a real link (target=_blank), so nothing reloads the page and
   it still opens the plain wa.me chat if JavaScript were ever unavailable.
   ========================================================================== */
(function(){
  var root = document.getElementById('coachingSection');
  if(!root) return;

  var PHONE    = '212660826700';
  var textarea = root.querySelector('#coachingMessage');
  var sendBtn  = root.querySelector('#coachingSendBtn');
  var boxes    = root.querySelectorAll('input[name="coaching-skill"]');
  if(!textarea || !sendBtn) return;

  function selectedSkills(){
    var list = [];
    for(var i = 0; i < boxes.length; i++){
      if(boxes[i].checked) list.push(boxes[i].value);   // DOM order, not click order
    }
    return list;
  }

  function buildMessage(){
    var skills  = selectedSkills();
    var note    = textarea.value.replace(/\r\n?/g, '\n').trim();   // keep the user's line breaks
    var parts   = ['سلام، بغيت نطلب Coaching.'];

    if(skills.length){
      parts.push('المهارات اللي عندي:\n' + skills.join(', '));
      if(note) parts.push('رسالتي:\n' + note);
    } else if(note){
      parts.push(note);                                            // no skills -> no skills section
    }
    parts.push('شكراً.');
    return parts.join('\n\n');
  }

  function encode(text){
    try { return encodeURIComponent(text); }
    catch(e){ return encodeURIComponent(text.replace(/[\uD800-\uDFFF]/g, '')); }   // never throw on a broken emoji
  }

  function refreshLink(){
    sendBtn.setAttribute('href', 'https://wa.me/' + PHONE + '?text=' + encode(buildMessage()));
  }

  // keep the link current while the user types / ticks skills…
  root.addEventListener('input',  refreshLink);
  root.addEventListener('change', refreshLink);
  // …and re-build it at the exact moment of the click (and for right-click / middle-click)
  sendBtn.addEventListener('click',       refreshLink);
  sendBtn.addEventListener('auxclick',    refreshLink);
  sendBtn.addEventListener('contextmenu', refreshLink);
  sendBtn.addEventListener('focus',       refreshLink);

  refreshLink();
})();
</script>

<script>
/* ==========================================================================
   PROMPTS COPY — isolated (own IIFE, no globals, only touches #promptsSection)
   Copies the FULL, exact text of a prompt to the clipboard for every
   "نسخ البرومبت" button. Uses the modern Clipboard API when available
   (desktop + mobile, secure contexts) and falls back to a hidden
   textarea + execCommand('copy') otherwise, so it also works over plain
   http/older browsers/embedded webviews.
   ========================================================================== */
(function(){
  var root = document.getElementById('promptsSection');
  if(!root) return;

  function fallbackCopy(text){
    var ta = document.createElement('textarea');
    ta.value = text;
    ta.setAttribute('readonly', '');
    ta.style.position = 'fixed';
    ta.style.top = '-1000px';
    ta.style.left = '-1000px';
    document.body.appendChild(ta);
    ta.focus();
    ta.select();
    ta.setSelectionRange(0, ta.value.length);   // needed on iOS Safari
    var ok = false;
    try { ok = document.execCommand('copy'); } catch(e){ ok = false; }
    document.body.removeChild(ta);
    return ok;
  }

  function copyText(text){
    if(navigator.clipboard && navigator.clipboard.writeText && window.isSecureContext){
      return navigator.clipboard.writeText(text);
    }
    return new Promise(function(resolve, reject){
      if(fallbackCopy(text)) resolve(); else reject(new Error('copy failed'));
    });
  }

  var buttons = root.querySelectorAll('.prompt-copy-btn');
  for(var i = 0; i < buttons.length; i++){
    (function(btn){
      var card      = btn.closest('.prompt-card');
      var pre       = card ? card.querySelector('.prompt-text') : null;
      var labelEl   = btn.querySelector('.copy-btn-label');
      var copyIcon  = btn.querySelector('.copy-icon');
      var checkIcon = btn.querySelector('.check-icon');
      var copyLabel   = btn.getAttribute('data-copy-label')   || 'نسخ البرومبت';
      var copiedLabel = btn.getAttribute('data-copied-label') || 'تم النسخ!';
      var resetTimer  = null;

      btn.addEventListener('click', function(){
        if(!pre) return;
        var fullText = pre.textContent;   // the ENTIRE prompt, exactly as shown — never a partial excerpt

        copyText(fullText).then(function(){
          btn.classList.add('is-copied');
          if(labelEl)   labelEl.textContent = copiedLabel;
          if(copyIcon)  copyIcon.hidden  = true;
          if(checkIcon) checkIcon.hidden = false;

          clearTimeout(resetTimer);
          resetTimer = setTimeout(function(){
            btn.classList.remove('is-copied');
            if(labelEl)   labelEl.textContent = copyLabel;
            if(copyIcon)  copyIcon.hidden  = false;
            if(checkIcon) checkIcon.hidden = true;
          }, 1800);
        }).catch(function(){
          if(labelEl) labelEl.textContent = 'تعذّر النسخ، حاول يدويًا';
          clearTimeout(resetTimer);
          resetTimer = setTimeout(function(){
            if(labelEl) labelEl.textContent = copyLabel;
          }, 2200);
        });
      });
    })(buttons[i]);
  }
})();
</script>

<script>
/* KPI ANALYZER (wrapped in its own function: no globals leak into the platform) */
(function(){
/* ===== CONFIGURATION: edit thresholds here ===== */
const CFG={
  MIN_SPEND_FOR_ANALYSIS:3,   // below this spend ($): "insufficient data"
  WEAK_SPEND_THRESHOLD:7,     // spend ($) with 0 purchases = weak conversion signal
  GOOD_CPA:5, HIGH_CPA:8,     // $ per purchase
  GOOD_CTR:1.0, LOW_CTR:0.7,  // %
  GOOD_HOOK_RATE:20, LOW_HOOK_RATE:12, // %
  GOOD_CVR:5, LOW_CVR:2,      // LPV -> purchase %
  GOOD_CPC:0.5,               // $
  MAX_CREATIVES:12,
  DEFAULT_CREATIVES:1         // ad set cards shown at start and after "Reset analysis"
};

/* ===== Helpers ===== */
const root=document.getElementById('kpiApp');
const $=(s,r=root)=>r.querySelector(s);
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
let creatives=[],uid=0,reportLang='en',L='en';
const x=(en,fr)=>L==='fr'?fr:en;
const withLang=(l,fn)=>{const o=L;L=l;try{return fn()}finally{L=o}};
const num=v=>{if(v===''||v==null)return null;const n=parseFloat(v);return isFinite(n)&&n>=0?n:null};
const fm=v=>v==null?'N/A':'$'+v.toFixed(2), fp=v=>v==null?'N/A':v.toFixed(2)+'%', fi=v=>Math.round(v).toLocaleString('en-US');
const fd=d=>d?d.split('-').reverse().join('/'):'—';
const tone=(v,good,bad,inv)=>v==null?'n':(inv?(v<=good?'g':v<=bad?'y':'r'):(v>=good?'g':v>=bad?'y':'r'));
const tCtr=v=>tone(v,CFG.GOOD_CTR,CFG.LOW_CTR),tCpa=v=>tone(v,CFG.GOOD_CPA,CFG.HIGH_CPA,1),tHook=v=>tone(v,CFG.GOOD_HOOK_RATE,CFG.LOW_HOOK_RATE),
      tCvr=v=>tone(v,CFG.GOOD_CVR,CFG.LOW_CVR),tCpc=v=>tone(v,CFG.GOOD_CPC,CFG.GOOD_CPC*1.6,1);

/* ===== Texts ===== */
const V={
strong:{c:'g',e:'🟢',l:['STRONG PERFORMER','PERFORMANCE FORTE'],t:[`Excellent purchase efficiency. This creative generates conversions at a competitive CPA and should be considered for progressive scaling.`,`Excellente efficacité d'achat. Ce créatif génère des conversions à un CPA compétitif et peut être envisagé pour un scaling progressif.`]},
convwin:{c:'g',e:'🟢',l:['CONVERSION WINNER','GAGNANT EN CONVERSION'],t:[`CTR is not the strongest, but the creative converts efficiently. Do not judge it by CTR alone: its purchase performance makes it one of the strongest creatives.`,`Le CTR n'est pas le plus élevé, mais le créatif convertit efficacement. Ne le jugez pas uniquement sur le CTR : ses achats en font l'un des meilleurs créatifs.`]},
traffic:{c:'y',e:'🟡',l:['TRAFFIC GENERATOR','GÉNÉRATEUR DE TRAFIC'],t:[`This creative generates good traffic and strong click performance, but purchase efficiency is weaker than the best creatives. Check the landing page, offer, product-market fit and pricing before scaling.`,`Ce créatif génère un bon trafic et de bons clics, mais l'efficacité d'achat est inférieure aux meilleurs créatifs. Vérifiez la landing page, l'offre, l'adéquation produit-marché et le prix avant de scaler.`]},
attention:{c:'y',e:'🟡',l:['NEEDS ATTENTION','À SURVEILLER'],t:[`Mixed results: purchases exist but CPA or conversion is not yet competitive. Monitor it and compare with your best creative.`,`Résultats mitigés : des achats existent mais le CPA ou la conversion n'est pas encore compétitif. Surveillez et comparez avec votre meilleur créatif.`]},
monitor:{c:'y',e:'🟡',l:['NEEDS MORE DATA','BESOIN DE PLUS DE DONNÉES'],t:[`No purchase yet, but spend is still low. Keep it running and monitor before deciding.`,`Pas encore d'achat, mais la dépense reste faible. Laissez tourner et surveillez avant de décider.`]},
weak:{c:'r',e:'🔴',l:['WEAK CONVERSION','CONVERSION FAIBLE'],t:[`The creative generates traffic but has not generated purchases. Avoid increasing budget for this creative until the creative, offer or landing page is improved.`,`Le créatif génère du trafic mais aucun achat. Évitez d'augmenter son budget avant d'améliorer le créatif, l'offre ou la landing page.`]},
insufficient:{c:'n',e:'⚪',l:['INSUFFICIENT DATA','DONNÉES INSUFFISANTES'],t:[`Not enough spend to judge this creative yet. Let it gather more data.`,`Dépense insuffisante pour juger ce créatif. Laissez-le collecter plus de données.`]}};
const REC={
scale:{c:'g',e:'🟢',l:['CONTINUE & SCALE','CONTINUER & SCALER'],t:[`Purchases and CPA are solid and at least one creative is a clear winner. Scale progressively (about +20% budget every 48h) on the strongest creatives.`,`Les achats et le CPA sont solides et au moins un créatif est gagnant. Scalez progressivement (environ +20% de budget toutes les 48h) sur les meilleurs créatifs.`]},
testing:{c:'y',e:'🟡',l:['CONTINUE TESTING','CONTINUER LE TEST'],t:[`Signals are promising or data is still limited. Keep testing so each creative gathers more purchases before any scaling decision.`,`Les signaux sont prometteurs ou les données encore limitées. Continuez le test pour que chaque créatif accumule plus d'achats avant de scaler.`]},
optimize:{c:'o',e:'🟠',l:['OPTIMIZE BEFORE SCALING','OPTIMISER AVANT DE SCALER'],t:[`Traffic is coming in but purchase efficiency is too weak. Improve the landing page, offer or pricing before spending more.`,`Le trafic arrive mais l'efficacité d'achat est trop faible. Améliorez la landing page, l'offre ou le prix avant de dépenser plus.`]},
review:{c:'r',e:'🔴',l:['REVIEW / RESTART TEST','REVOIR / RELANCER LE TEST'],t:[`Meaningful spend with no purchases. Review the product, offer, creatives and targeting, then restart the test with improvements.`,`Dépense significative sans achat. Revoyez le produit, l'offre, les créatifs et le ciblage, puis relancez le test avec des améliorations.`]}};
const vl=(o,i)=>o.l[L==='fr'?1:0], vt=o=>o.t[L==='fr'?1:0];

/* ===== Calculations ===== */
function calc(c,noOv){
  const s=num(c.spend),i=num(c.impr),k=num(c.clicks),l=num(c.lpv),p=num(c.purch);
  const d=(a,b,m=1)=>a!=null&&b!=null&&b>0?a/b*m:null;
  const ov=(f,v)=>(!noOv&&num(c[f])!=null)?num(c[f]):v; /* seller-typed KPI wins over auto-calculation */
  return{s:s||0,r:num(c.reach)||0,i:i||0,k:k||0,l:l||0,p:p||0,ctr:ov('kctr',d(k,i,100)),cpc:ov('kcpc',d(s,k)),cpm:ov('kcpm',d(s,i,1000)),lpvr:d(l,k,100),
    cvr:d(p||0,l,100),cpa:ov('kcpa',(p>0&&s!=null)?s/p:null),hook:ov('khook',null)};
}
function verdict(k){
  if(k.s<CFG.MIN_SPEND_FOR_ANALYSIS)return'insufficient';
  if(k.p===0)return(k.s>=CFG.WEAK_SPEND_THRESHOLD&&k.k>0)?'weak':'monitor';
  if(k.cpa<=CFG.GOOD_CPA&&(k.cvr==null||k.cvr>=CFG.LOW_CVR))return(k.ctr!=null&&k.ctr<CFG.GOOD_CTR)?'convwin':'strong';
  if(k.ctr!=null&&k.ctr>=CFG.GOOD_CTR)return'traffic';
  return'attention';
}
const cmp=(a,b)=>(b.k.p-a.k.p)||((a.k.cpa??Infinity)-(b.k.cpa??Infinity))||((b.k.cvr||0)-(a.k.cvr||0))||((b.k.ctr||0)-(a.k.ctr||0));
function totals(list){
  const T={s:0,r:0,i:0,k:0,l:0,p:0,h:0,hi:0};
  list.forEach(o=>{T.s+=o.k.s;T.r+=o.k.r;T.i+=o.k.i;T.k+=o.k.k;T.l+=o.k.l;T.p+=o.k.p;
    if(o.k.hook!=null&&o.k.i>0){T.h+=o.k.hook*o.k.i/100;T.hi+=o.k.i}});
  const d=(a,b,m=1)=>b>0?a/b*m:null;
  return{...T,ctr:d(T.k,T.i,100),cpc:d(T.s,T.k),cpm:d(T.s,T.i,1000),lpvr:d(T.l,T.k,100),cvr:d(T.p,T.l,100),cpa:T.p>0?T.s/T.p:null,hook:d(T.h,T.hi,100)};
}
function recommend(G,list){
  const n=Math.max(1,list.length),win=list.filter(o=>o.v==='strong'||o.v==='convwin').length;
  if(G.s<CFG.MIN_SPEND_FOR_ANALYSIS*n)return'testing';
  if(G.p===0)return G.s>=CFG.WEAK_SPEND_THRESHOLD*n?'review':'testing';
  if(G.cpa>CFG.HIGH_CPA||(G.l>=30&&G.cvr<CFG.LOW_CVR))return'optimize';
  if(G.cpa<=CFG.GOOD_CPA&&G.p>=3&&win>0)return'scale';
  return'testing';
}
function analyse(){
  const list=creatives.map((c,i)=>{const k=calc(c);return{c,i,k,v:verdict(k),name:c.name.trim()||null}});
  const act=list.filter(o=>o.k.s>0||o.k.i>0);
  const G=totals(list),ranked=[...act].sort(cmp);
  const best=ranked[0]&&ranked[0].k.p>0?ranked[0]:null;
  const last=ranked[ranked.length-1];
  const weak=(act.length>1&&last!==best&&last.k.s>=CFG.MIN_SPEND_FOR_ANALYSIS&&(last.v==='weak'||last.v==='attention'||last.v==='traffic'||last.v==='monitor'))?last:null;
  const watch=act.filter(o=>o!==best&&o!==weak&&['traffic','attention','monitor'].includes(o.v)).sort((a,b)=>b.k.s-a.k.s)[0]||null;
  return{list,act,G,best,weak,watch,rec:recommend(G,act)};
}
const nm=o=>o.name||(x('VIDEO ','VIDÉO ')+(o.i+1));
function insights(A){
  const{act,G,best,weak}=A,out=[];
  if(best)out.push(x(`${nm(best)} is currently the strongest conversion creative (${best.k.p} purchase${best.k.p>1?'s':''}, CPA ${fm(best.k.cpa)}).`,`${nm(best)} est actuellement le créatif le plus fort en conversion (${best.k.p} achat${best.k.p>1?'s':''}, CPA ${fm(best.k.cpa)}).`));
  const top=[...act].filter(o=>o.k.s>=CFG.MIN_SPEND_FOR_ANALYSIS&&o.k.ctr!=null).sort((a,b)=>b.k.ctr-a.k.ctr)[0];
  if(top&&top!==best&&best&&(top.k.p<best.k.p||(top.k.cpa||Infinity)>best.k.cpa))out.push(x(`${nm(top)} has the highest CTR (${fp(top.k.ctr)}) but weaker purchase efficiency.`,`${nm(top)} a le CTR le plus élevé (${fp(top.k.ctr)}) mais une efficacité d'achat plus faible.`));
  act.filter(o=>o.v==='weak').slice(0,2).forEach(o=>out.push(x(`${nm(o)} generates traffic but has not generated purchases.`,`${nm(o)} génère du trafic mais n'a pas généré d'achats.`)));
  if(G.l>=30&&G.cvr!=null&&G.cvr<CFG.LOW_CVR)out.push(x(`Review the landing page: LPV volume is good but conversion is weak (${fp(G.cvr)}).`,`La landing page doit être revue : le volume de LPV est bon mais la conversion est faible (${fp(G.cvr)}).`));
  else if(G.lpvr!=null&&G.k>=30&&G.lpvr<70)out.push(x(`Only ${fp(G.lpvr)} of clicks become landing page views. Check page speed and the link.`,`Seulement ${fp(G.lpvr)} des clics deviennent des visites de landing page. Vérifiez la vitesse de la page et le lien.`));
  out.push(G.p>=5?x(`The campaign has enough purchase data (${G.p}) to begin identifying winning creatives.`,`La campagne a assez d'achats (${G.p}) pour commencer à identifier les créatifs gagnants.`)
    :x(`Data is still limited (${G.p} purchase${G.p===1?'':'s'}). Keep testing before making big decisions.`,`Les données restent limitées (${G.p} achat${G.p===1?'':'s'}). Continuez à tester avant les grandes décisions.`));
  if(G.hook!=null)out.push(G.hook>=CFG.GOOD_HOOK_RATE?x(`Hook Rate is strong (${fp(G.hook)}): your openings capture attention.`,`Le Hook Rate est fort (${fp(G.hook)}) : vos débuts de vidéo captent l'attention.`)
    :G.hook<CFG.LOW_HOOK_RATE?x(`Hook Rate is low (${fp(G.hook)}): test stronger first 3 seconds.`,`Le Hook Rate est faible (${fp(G.hook)}) : testez des 3 premières secondes plus fortes.`):'');
  out.push(x(`Do not scale based on CTR alone: purchases and CPA come first.`,`Ne scalez pas sur le seul CTR : les achats et le CPA passent en premier.`));
  return out.filter(Boolean).slice(0,5);
}

/* ===== Report ===== */
function info(){const g=id=>$('#'+id).value.trim();return{seller:g('seller'),product:g('product'),country:g('country'),camp:g('camp'),sd:g('sd'),ed:g('ed'),bud:g('bud')}}
function buildReport(l){return withLang(l,()=>{
  const I=info(),A=analyse(),G=A.G,o=[];
