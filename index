    // allow a bare file ID (no full link) as a fallback — real Drive IDs are
    // long (usually 25+ characters), which avoids mistaking plain text for one
    if(/^[a-zA-Z0-9_-]{20,}$/.test(s)) return s;
    return null;
  }

  function parseVideoConfig(raw){
    var videos = [];
    var blocks = raw.split(/(?=^[ \t]*VIDEO\s*\d+[ \t]*$)/im);
    blocks.forEach(function(block){
      var driveMatch = block.match(/Drive\s*:\s*(.*)/i);
      var titleMatch = block.match(/Title\s*:\s*(.*)/i);
      var driveRaw = driveMatch ? driveMatch[1].trim() : '';
      var titleRaw = titleMatch ? titleMatch[1].trim() : '';
      if(!driveRaw || !titleRaw) return; // both required, otherwise skip silently
      var id = extractDriveFileId(driveRaw);
      if(!id){
        console.warn('COD with imihi: تم تجاهل فيديو بسبب رابط Google Drive غير صالح ->', driveRaw);
        return;
      }
      videos.push({ id:id, title:titleRaw });
    });
    return videos;
  }

  function escapeHtml(str){
